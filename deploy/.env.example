# Copy to deploy/.env, chmod 600. Never commit the real file.
ELEVENLABS_API_KEY=changeme
ELEVENLABS_VOICE_ID=changeme
# Shared bearer key for both Hermes API servers (generate: python -c "import secrets; print(secrets.token_urlsafe(32))")
# Must be IDENTICAL to API_SERVER_KEY in the root-only secrets file read by
# deploy/install-hermes.sh (default /root/jarvis-secrets.env).
API_SERVER_KEY=changeme
# No LLM key belongs here: Hermes logs in to OpenAI Codex with OAuth
# (`hermes auth add openai-codex` as the hermes user), never via this file.
# Managed by: python -m scripts.tokens add|revoke <device> --env deploy/.env
# then `docker compose -f deploy/docker-compose.yml up -d` (restart does not reload this file).
DEVICE_TOKENS=
# Optional overrides
# One Hermes host gateway serves both profiles:
# HERMES_FAST_URL=http://127.0.0.1:8642/p/fast
# HERMES_DEEP_URL=http://127.0.0.1:8642/p/deep
# STT_MODEL=base
# CANNED_DIR=cache/canned
