[Unit]
Description=Hermes Agent (fast profile, claude-haiku-5-5, 127.0.0.1:8642)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hermes
# VERIFY: `hermes -p <profile> gateway` per the API-server docs; confirm it stays in the foreground.
ExecStart=/home/hermes/.local/bin/hermes -p fast gateway
Restart=on-failure
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
